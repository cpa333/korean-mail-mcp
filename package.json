{
  "name": "@cpal1828/korean-mail-mcp",
  "version": "0.1.0",
  "description": "네이버·다음 메일을 읽고 임시보관함에 초안을 저장하는 MCP 서버 (Claude Code용)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "korean-mail-mcp": "dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpa333/korean-mail-mcp.git"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.cjs --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@zone-eu/mailsplit": "5.4.31",
    "esbuild": "^0.28.2",
    "html-to-text": "10.0.1",
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.4",
    "nodemailer": "^10.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
